# ============================================================
# PERINGATAN — WAJIB DIBACA sebelum menjalankan app ini
# ============================================================
# File ini CONTOH, bukan file konfigurasi asli. App-nya TIDAK akan
# jalan (bakal error di setiap fitur peta/rute) sampai kamu:
#
#   1. Rename/copy file ini jadi:  .streamlit/secrets.toml
#      (hapus akhiran ".example")
#   2. Daftar API key GRATIS di https://openrouteservice.org/dev/#/signup
#   3. Ganti nilai di bawah dengan API key kamu sendiri
#
# JANGAN commit file secrets.toml (bukan yang .example ini) ke git —
# itu isinya credential pribadi. .gitignore di folder ini sudah
# nge-exclude "secrets.toml" (tapi tidak exclude "secrets.toml.example"
# ini), jadi selama kamu ikutin langkah di atas, key kamu aman.
# ============================================================

ORS_API_KEY = "isi-dengan-api-key-openrouteservice-kamu-sendiri"
